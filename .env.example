# Local development (.env at repo root)
OPENAI_API_KEY=sk-your-key-here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=isat_recruiter
DB_USER=postgres
DB_PASSWORD=

# Vercel (Frontend project settings → Environment Variables)
# BACKEND_URL=https://your-railway-api.up.railway.app

# Railway Python service (Variables tab)
# OPENAI_API_KEY=sk-your-key-here
# DATABASE_URL=${{Postgres.DATABASE_URL}}
#
# Railway auto-fills DATABASE_URL when you reference your Postgres service.
# Use the "Postgres + pgvector" template when adding the database.
